# SQLite database file, created on first run.
DATABASE_URL=file:./ascot-payload.db

# A long random string, e.g. from `openssl rand -hex 32`.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Optional: the site's public address, used for share links. Defaults to the request's host.
# NEXT_PUBLIC_SERVER_URL=https://www.ascotgroup.co.uk

# Optional: override the Font Awesome kit ID.
# NEXT_PUBLIC_FONT_AWESOME_KIT=4ff287f21b
