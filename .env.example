# Postgres connection string. Locally: Homebrew Postgres 17 (see README).
DATABASE_URL=postgres://localhost:5432/ascot_payload

# A long random string, e.g. from `openssl rand -hex 32`. Unique to each environment.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Optional locally: the site's public address, used for share links. On DigitalOcean
# this must be a literal URL, scoped Build and Run Time.
# NEXT_PUBLIC_SERVER_URL=https://www.ascotgroup.co.uk

# Optional: override the Font Awesome kit ID.
# NEXT_PUBLIC_FONT_AWESOME_KIT=4ff287f21b

# Production only: DigitalOcean managed Postgres' CA certificate.
# DATABASE_CA_CERT=

# Production only: DigitalOcean Spaces, so uploads survive redeploys. Leave S3_BUCKET
# unset locally to keep uploads on disk (media/ and cvs/).
# S3_BUCKET=
# S3_ENDPOINT=https://lon1.digitaloceanspaces.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=ascot-payload
